{
  "name": "@workspace/learn-app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "build": "expo export --platform web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:data": "node --test scripts/*.test.mjs",
    "guides": "node scripts/build-trace-guides.mjs",
    "test:e2e": "expo export --platform web && playwright test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-audio": "^58.0.11",
    "expo-constants": "~58.0.15",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-speech": "^58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "axe-core": "^4.14.0",
    "babel-preset-expo": "~58.0.24",
    "eslint": "^9",
    "eslint-config-expo": "~58.0.4",
    "harfbuzzjs": "1.6.3",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.0.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  }
}
