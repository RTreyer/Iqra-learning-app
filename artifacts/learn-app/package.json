{
  "name": "@workspace/learn-app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "build": "expo export --platform web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:data": "node --test scripts/*.test.mjs",
    "guides": "node scripts/build-trace-guides.mjs",
    "test:e2e": "expo export --platform web && playwright test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.24",
    "expo-constants": "~56.0.27",
    "expo-haptics": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.19",
    "expo-router": "~56.2.22",
    "expo-speech": "^56.0.3",
    "expo-splash-screen": "~56.0.16",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.2",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "axe-core": "^4.14.0",
    "babel-preset-expo": "~56.0.21",
    "eslint": "^9",
    "eslint-config-expo": "~56.0.4",
    "harfbuzzjs": "1.6.3",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.6",
    "prettier": "^3.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
